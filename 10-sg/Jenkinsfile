pipeline {
    agent {
        label 'agent-1'
    } 

    environment {
        appVersion = ""
        REGION = "us-east-1"
        ACC_ID = "838180513114"
        PROJECT = "roboshop"
        COMPONENT = "catalogue"
    }

    options {
        timeout(time: 30, unit: 'MINUTES') 
        disableConcurrentBuilds()
        ansiColor('xterm')
    }

    stages {

        stage('Verify AWS Identity') {
            steps {
                script {
                    withAWS(credentials: 'aws-creds', region: "${REGION}") {
                        sh '''
                            echo "=== WHO AM I (Jenkins) ==="
                            aws sts get-caller-identity

                            echo "=== REGION ==="
                            aws configure get region || echo "No region configured"
                        '''
                    }
                }
            }
        }

        stage('Init') {
            steps {
                withAWS(credentials: 'aws-creds', region: "${REGION}") {
                    dir('10-sg') {
                        sh 'terraform init -reconfigure'
                    }
                }
            }
        }

        stage('terraform plan') {
            steps {
                withAWS(credentials: 'aws-creds', region: "${REGION}") {
                    dir('10-sg') {
                        sh 'terraform plan'
                    }
                }
            }
        }

        stage('terraform apply') {
            steps {
                withAWS(credentials: 'aws-creds', region: "${REGION}") {
                    dir('10-sg') {
                        sh 'terraform apply -auto-approve'
                    }
                }
            }
        }
        // =========================================================================
        // CORRECTED INFRASTRUCTURE FAN-OUT (Parallel with Sequential Triggers)
        // =========================================================================
        stage('BASTION ACM EKS') {
            parallel {
                stage('Trigger BASTION') {
                    steps {
                        build job: '20-bastion',
                        wait: false, // VPC will not wait for SG pipeline completion
                        propagate: false // even SG fails VPC will not be effected
                    }
                }
                stage('Trigger EKS') {
                    steps {
                        build job: '80-eks',
                        wait: false,
                        propagate: false
                    }
                }
            }
        }
        //  ACM finishes -> Then immediately triggers Frontend/ALB dependent resources.
        // This fulfills your exact "Frontend/ALB depends on ACM" requirement.
        stage('ACM & Application Ingress Routing Track') {
            stage('Trigger ACM') { // Must wait for certificate validation to finish completely
                steps {
                    build job: '60-acm', // Must wait for certificate validation to finish completely
                    wait: true,
                    propagate: true
                }
            }
            stage('Trigger alb') {
                steps {
                    script {
                        // Triggers sequentially ONLY after ACM is successfully provisioned
                        build job: '70-ingress-alb',
                        wait: true,
                        propagate: true
                    }
                }
            }
        }
        // =========================================================================
        // FINAL VALIDATION GATING
        // =========================================================================
        stage('Post-Deployment Health Checks') {
            steps {
                echo "Both EKS Cluster and ACM/ALB tracks have completed successfully."
                echo "Running final end-to-end integration and smoke tests..."
            }
        }
    }

    post { 
        always { 
            echo 'Infrastructure provisioning cycle completed.'
        }
        success { 
            echo 'Pipeline success: All infrastructure stacks deployed seamlessly'
        }
        failure { 
            echo 'Pipeline failed: One or more critical downstream jobs crashed.'
        }
    }

}